# ============================================================
# PRODUCTION ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env and fill in all values
# NEVER commit .env file to version control
# ============================================================

# ---- APPLICATION SETTINGS ----
ENVIRONMENT=production
DEBUG=false

# ---- DATABASE CONNECTION ----
# PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://postgres:secure_password@db:5432/hackfusion
DATABASE_SSL=prefer

# ---- REDIS CACHE ----
REDIS_URL=redis://redis:6379/0

# ---- JWT & AUTHENTICATION ----
# Generate a strong secret key: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your_strong_secret_key_here_at_least_32_characters_long
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- CORS & SECURITY ----
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# ---- HTTPS/TLS ----
# If using HTTPS, provide cert paths
USE_HTTPS=false
SSL_CERT_PATH=/app/certs/cert.pem
SSL_KEY_PATH=/app/certs/key.pem

# ---- EMAIL SERVICE (for notifications) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM_EMAIL=noreply@hackfusion.com

# ---- PayU PAYMENT GATEWAY ----
PAYU_MERCHANT_ID=your_merchant_id
PAYU_MERCHANT_KEY=your_merchant_key
PAYU_API_URL=https://secure.payu.in
PAYU_SUCCESS_URL=https://yourdomain.com/payment/success
PAYU_FAILURE_URL=https://yourdomain.com/payment/failure

# ---- CELERY & REDIS TASKS ----
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ---- LOGGING ----
LOG_LEVEL=info
LOG_FORMAT=json

# ---- AWS (Optional - for S3 backups) ----
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-backup-bucket

# ---- RATE LIMITING ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100
LOGIN_RATE_LIMIT_PER_MINUTE=5

# ---- SENTRY (Error Tracking) ----
SENTRY_DSN=https://your_sentry_dsn_here@sentry.io/project_id
SENTRY_ENVIRONMENT=production

# ---- MONITORING ----
PROMETHEUS_ENABLED=true
METRICS_PORT=8001
